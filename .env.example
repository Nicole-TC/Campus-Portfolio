# Copiar este archivo como ".env" y completar con los datos reales.
# El ".env" real NUNCA se sube a git (ya está en .gitignore).

# --- Base de datos ---
DB_HOST=localhost
DB_USER=usuario
DB_PASSWORD=contrasenia
DB_NAMEDB=nombre_db
DB_PORT=5432

# --- Autenticación ---
JWT_SECRET=tu_secreto_super_seguro_aqui

# --- Puerto público asignado ---
PUBLIC_PORT=8080

# --- Bot de Telegram ---
TELEGRAM_TOKEN=tu_token_de_telegram_aqui

BACKEND_URL=http://backend:8000
